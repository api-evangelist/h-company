{
  "opencollection": "1.0.0",
  "info": {
    "name": "Computer-Use Agents Schedules API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Schedules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Schedules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://agp.eu.hcompany.ai/api/v2/schedules",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort by field"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List the organization's schedules."
        },
        {
          "info": {
            "name": "Create Schedule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://agp.eu.hcompany.ai/api/v2/schedules",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a schedule that starts a session on each fire."
        },
        {
          "info": {
            "name": "Get Schedule",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://agp.eu.hcompany.ai/api/v2/schedules/:schedule_id",
            "params": [
              {
                "name": "schedule_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetch a schedule by id."
        },
        {
          "info": {
            "name": "Update Schedule",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://agp.eu.hcompany.ai/api/v2/schedules/:schedule_id",
            "params": [
              {
                "name": "schedule_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a schedule; only provided fields change. Timing changes recompute the next fire."
        },
        {
          "info": {
            "name": "Delete Schedule",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://agp.eu.hcompany.ai/api/v2/schedules/:schedule_id",
            "params": [
              {
                "name": "schedule_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a schedule. Future fires stop; sessions already created keep running."
        },
        {
          "info": {
            "name": "Pause Schedule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://agp.eu.hcompany.ai/api/v2/schedules/:schedule_id/pause",
            "params": [
              {
                "name": "schedule_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Pause a schedule with an optional note."
        },
        {
          "info": {
            "name": "Resume Schedule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://agp.eu.hcompany.ai/api/v2/schedules/:schedule_id/resume",
            "params": [
              {
                "name": "schedule_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Resume a paused schedule; the next fire is recomputed from now."
        },
        {
          "info": {
            "name": "Trigger Schedule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://agp.eu.hcompany.ai/api/v2/schedules/:schedule_id/trigger",
            "params": [
              {
                "name": "schedule_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fire the schedule once now (works while paused); the regular cadence is unaffected."
        },
        {
          "info": {
            "name": "List Schedule Runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://agp.eu.hcompany.ai/api/v2/schedules/:schedule_id/runs",
            "params": [
              {
                "name": "schedule_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort by field"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List the schedule's recent run outcomes, newest fire first."
        }
      ]
    }
  ],
  "bundled": true
}